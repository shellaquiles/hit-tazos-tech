{
  "name": "hit-tazos-tech",
  "version": "1.0.0-rc3",
  "description": "Juego de cartas y trivia cronológica técnica centrado en el ecosistema de software, Python, infraestructura, IA y cultura hacker.",
  "main": "web/app.js",
  "scripts": {
    "build": "node scripts/build_cards.js",
    "audit": "python3 scripts/audit_deck.py",
    "test": "python3 scripts/audit_deck.py && node --check web/app.js && node --check scripts/build_cards.js && node --check print/render_print_tabloid.js && node --check scripts/generate_card_colors.js && node --check server.js",
    "validate": "npm test && npm run build",
    "serve": "node server.js",
    "colors:generate": "node scripts/generate_card_colors.js",
    "print": "node print/render_print_tabloid.js",
    "print:tabloide": "node print/render_print_tabloid.js --format=11x17",
    "print:8x11": "node print/render_print_tabloid.js --format=8x11",
    "print:carta": "node print/render_print_tabloid.js --format=8x11",
    "print:volumes": "node print/render_print_tabloid.js --volume=all-volumes",
    "print:carta:volumes": "node print/render_print_tabloid.js --format=8x11 --volume=all-volumes",
    "print:test": "node print/render_print_tabloid.js --range=sample",
    "print:test:tabloide": "node print/render_print_tabloid.js --format=11x17 --range=15",
    "print:test:8x11": "node print/render_print_tabloid.js --format=8x11 --range=6",
    "print:test:carta": "node print/render_print_tabloid.js --format=8x11 --range=6"
  },
  "keywords": [
    "hit-tazos",
    "trivia",
    "timeline",
    "python",
    "developer",
    "open-source",
    "board-game",
    "card-game",
    "shellaquiles"
  ],
  "author": "Shellaquiles Org <pixelead0>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shellaquiles/hit-tazos-tech.git"
  },
  "bugs": {
    "url": "https://github.com/shellaquiles/hit-tazos-tech/issues"
  },
  "homepage": "https://github.com/shellaquiles/hit-tazos-tech#readme"
}
